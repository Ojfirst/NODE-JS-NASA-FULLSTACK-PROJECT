		"dotenv": "^18.0.4",
		"express": "^5.2.1",
		"mongodb": "^7.1.1",
		"mongoose": "^9.4.1",
		"morgan": "^1.10.1",
		"pino": "^10.3.1",
		"pino-http": "^11.0.0",
		"pm2": "^7.0.4"
	},
